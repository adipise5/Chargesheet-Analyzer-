APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
MAX_UPLOAD_MB=250
OCR_CONFIDENCE_THRESHOLD=70
OCR_WORKERS=2
LLM_CONCURRENCY=1
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# 16 GB default; use qwen3.5:9b on 24/32 GB machines
LLM_MODEL=qwen3.5:4b
EMBEDDING_MODEL=bge-m3
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_ENABLED=false
REQUIRE_NEO4J=false
